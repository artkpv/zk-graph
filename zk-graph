  var freshIds = new Set();
  var toAdd = [];
  fresh.forEach(function(e) {
    freshIds.add(e.id);
    if (!edges.get(e.id) && nodes.get(e.from) && nodes.get(e.to)) toAdd.push(e);
  });
  edges.add(toAdd);
  edges.remove(edges.getIds({
    filter: function(e) { return isStale(e) && !freshIds.has(e.id); }
  }));
