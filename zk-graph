def script_json(obj):
    """JSON safe to embed inside a <script> block."""
    return json.dumps(obj).replace("</", "<\\/")


def make_html(vis_data, token):
    legend_items = "\n".join(
        f'  <div><span style="background:{color}"></span>{html_mod.escape(tag)}</div>'
        for tag, color in TAG_COLORS.items()
    )
    subs = {
        "DEFAULT_COLOR": DEFAULT_COLOR,
        "LEGEND_ITEMS": legend_items,
        "GRAPH_DATA": script_json(vis_data),
        "TOKEN": script_json(token),
    }
    # Single pass, so substituted note content is never re-scanned for markers
    return re.sub(r"@@(\w+)@@", lambda m: subs[m.group(1)], HTML_TEMPLATE)


def open_note(path):
    """Run OPEN_CMD with {path}/{notebook} filled in; path is appended if absent."""
    fields = {"path": os.path.join(NOTES_DIR, path), "notebook": NOTES_DIR}
    # Plain str.replace per argument: no shell, so note paths can't inject commands
    cmd = [arg.replace("{path}", fields["path"]).replace("{notebook}", fields["notebook"])
           for arg in OPEN_CMD]
    if not any("{path}" in arg for arg in OPEN_CMD):
        cmd.append(fields["path"])
    subprocess.Popen(
        cmd, cwd=NOTES_DIR, start_new_session=True,
        stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
    )


class GraphHandler(BaseHTTPRequestHandler):
    html_content = b""
    vis_js = b""
    token = ""
    allowed_hosts = set()
    notes_by_path = {}  # all notes keyed by path
    links = []          # all links from zk
    adj = ({}, {})      # adjacency() of the whole notebook
    loaded_at = 0.0     # time.time() just before the last `zk graph` run
    reload_lock = threading.Lock()

    @classmethod
    def reload(cls):
        # Stamp before running zk, so edits made while it runs trigger the next reload
        started = time.time()
        fresh = get_graph_json()
        notes_by_path = {n["path"]: n for n in fresh["notes"]}
        adj = adjacency(fresh["links"], notes_by_path)
        cls.notes_by_path, cls.links, cls.adj = notes_by_path, fresh["links"], adj
        cls.loaded_at = started
        return notes_by_path, fresh["links"], adj

    @classmethod
    def current(cls):
        """The cached graph, re-read via zk only if notebook files changed since."""
        with cls.reload_lock:
            if changed_since(NOTES_DIR, cls.loaded_at):
                return cls.reload()
            return cls.notes_by_path, cls.links, cls.adj

    def _send(self, code, body=b"", ctype="text/plain; charset=utf-8"):
        self.send_response(code)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def _send_json(self, obj):
        self._send(200, json.dumps(obj).encode(), "application/json; charset=utf-8")

    def _host_ok(self):
        # Blocks DNS-rebinding: only our own origin names are accepted
        return self.headers.get("Host", "") in self.allowed_hosts

    def do_GET(self):
        if not self._host_ok():
            return self._send(403, b"forbidden")
        route = urllib.parse.urlparse(self.path).path
        if route == "/":
            return self._send(200, self.html_content, "text/html; charset=utf-8")
        if route == "/vis-network.min.js":
            return self._send(200, self.vis_js, "text/javascript; charset=utf-8")
        self._send(404, b"not found")

    def do_POST(self):
        # The custom X-Token header forces a CORS preflight, which we never
        # answer, so other sites can't trigger these endpoints.
        token = self.headers.get("X-Token", "")
        if not self._host_ok() or not hmac.compare_digest(token.encode(), self.token.encode()):
            return self._send(403, b"forbidden")
        length = int(self.headers.get("Content-Length") or 0)
        try:
            body = json.loads(self.rfile.read(length) or b"{}")
        except ValueError:
            return self._send(400, b"bad json")

        route = urllib.parse.urlparse(self.path).path
        try:
            if route == "/open":
                path = body.get("path", "")
                if path not in self.notes_by_path:
                    return self._send(404, b"unknown note")
                try:
                    open_note(path)
                except OSError as e:
                    return self._send(500, f"open_cmd failed: {e}".encode())
                return self._send_json({"ok": True})
            if route == "/neighbors":
                direction = body.get("direction", "both")
                if direction not in DIRECTIONS:
                    return self._send(400, b"bad direction")
                return self._send_json(self._neighbors(
                    body.get("path", ""), direction, set(body.get("shown", []))))
            if route == "/refresh":
                return self._send_json(self._refresh(set(body.get("paths", []))))
        except ZkError as e:
            return self._send(500, str(e).encode())
        self._send(404, b"not found")

    def _refresh(self, paths):
        """Return updated nodes and valid edges for given paths."""
        notes_by_path, links, adj = self.current()
        vis_nodes = [note_to_vis_node(notes_by_path[p], adj) for p in paths if p in notes_by_path]
        return {"nodes": vis_nodes, "edges": vis_edges(links, paths)}

    def _neighbors(self, path, direction, shown):
        """Return path's linked notes in `direction`
        + edges among shown and new nodes."""
        notes_by_path, links, adj = self.current()
        neighbor_paths = linked(adj, path, direction)
        vis_nodes = [note_to_vis_node(notes_by_path[p], adj) for p in neighbor_paths]
        return {"nodes": vis_nodes, "edges": vis_edges(links, shown | neighbor_paths | {path})}

    def log_message(self, format, *args):
        pass  # silence logs


def main():
    global NOTES_DIR
    parser = argparse.ArgumentParser(description="Visualize a zk notebook's link graph in the browser")
    parser.add_argument("--notebook", help="Notebook directory (default: $ZK_NOTEBOOK_DIR or nearest parent with .zk/)")
    parser.add_argument("--filter", default="", help="Filter notes by search string")
    parser.add_argument("--filter-path", default="", help="Filter notes by path prefix")
    parser.add_argument("--depth", type=int, default=1, help="How many link hops from matched notes to include (default: 1)")
    parser.add_argument("--direction", choices=DIRECTIONS, default="both",
                        help="Which links --depth follows: out = notes they link to, in = backlinks (default: both)")
    parser.add_argument("--port", type=int, default=8089, help="HTTP port (default: 8089)")
    parser.add_argument("--no-open", action="store_true", help="Don't open a browser")
    args = parser.parse_args()

    try:
        GraphHandler.vis_js = VIS_JS_PATH.read_bytes()
    except OSError as e:
        sys.exit(f"Cannot read {VIS_JS_PATH}: {e.strerror}")

    try:
        notebook = Path(args.notebook).resolve() if args.notebook else find_notebook_dir(os.getcwd())
        NOTES_DIR = str(notebook)
        load_config(notebook)
        print(f"Loading graph from zk notebook {NOTES_DIR}...")
        notes_by_path, links, adj = GraphHandler.reload()
    except ZkError as e:
        sys.exit(str(e))
    print(f"Total: {len(notes_by_path)} notes, {len(links)} links")

    data = {"notes": list(notes_by_path.values()), "links": links}
    data = filter_graph(data, adj, args.filter, args.filter_path, args.depth, args.direction)
    print(f"After filter: {len(data['notes'])} notes, {len(data['links'])} links")
    if not data["notes"]:
        print("Warning: no notes matched the filter", file=sys.stderr)

    try:
        server = ThreadingHTTPServer(("127.0.0.1", args.port), GraphHandler)
    except OSError as e:
        sys.exit(f"Cannot bind 127.0.0.1:{args.port}: {e.strerror}. Try another --port.")
    port = server.server_address[1]

    GraphHandler.token = secrets.token_urlsafe(32)
    GraphHandler.allowed_hosts = {f"127.0.0.1:{port}", f"localhost:{port}"}
    GraphHandler.html_content = make_html(build_vis_data(data, adj), GraphHandler.token).encode()

    url = f"http://127.0.0.1:{port}"
    print(f"Serving graph at {url}")
    if not args.no_open:
        webbrowser.open(url)

    try:
        server.serve_forever()
    except KeyboardInterrupt:
        print("\nStopped.")


if __name__ == "__main__":
    main()
