// Add the notes linked with `path` in `direction` ("both", "out" or "in")
function expand(path, direction) {
  setInfo("Loading linked notes…");
  api("/neighbors", { path: path, direction: direction, shown: nodes.getIds() })
    .then(function(result) {
      var added = result.nodes.filter(function(n) { return !nodes.get(n.id); });
      // Start new notes on a circle around the clicked one, so they don't pile
      // up in the middle when the layout is frozen
      var c = nodes.get(path) ? network.getPosition(path) : { x: 0, y: 0 };
      added.forEach(function(n, i) {
        var a = 2 * Math.PI * i / added.length;
        n.x = c.x + 150 * Math.cos(a);
        n.y = c.y + 150 * Math.sin(a);
      });
      nodes.add(added.map(prepNode));
      // Edges among shown + new nodes; stale ones only for the clicked node
      syncEdges(result.edges, function(e) { return e.from === path || e.to === path; });
      if (added.length) markDirty();
      setInfo();
    })
    .catch(showError);
}

