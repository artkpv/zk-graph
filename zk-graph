  hideCtxMenu();
  api("/neighbors", { path: path, shown: nodes.getIds() })
    .then(function(result) {
      nodes.add(result.nodes.filter(function(n) { return !nodes.get(n.id); }).map(prepNode));
      // Edges among shown + new nodes; stale ones only for the clicked node
      syncEdges(result.edges, function(e) { return e.from === path || e.to === path; });
