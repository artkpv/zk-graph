#!/usr/bin/env python3
"""Visualize a zk notebook's link graph in a web browser using vis-network.

This script loads the graph with `zk graph`, keeps it cached in memory, and
serves the page in static/ plus a small JSON API on 127.0.0.1:

    GET  /init             the graph to show at start, the API token, the legend
    POST /open             open a note in the editor (config: open_cmd)
    POST /neighbors        a note's linked notes, for expanding the graph
    POST /refresh          fresh content and links for the displayed notes
    POST /views/list|load|save   saved views

https://github.com/artkpv/zk-graph
"""

import argparse
import hmac
import html
import json
import math
import os
import re
import secrets
import shlex
import subprocess
import sys
import tempfile
import threading
import time
import tomllib
import urllib.parse
import webbrowser
from dataclasses import dataclass, field
from datetime import datetime, timezone
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from pathlib import Path

STATIC_DIR = Path(__file__).resolve().parent / "static"
STATIC_FILES = {  # URL path -> (file in STATIC_DIR, content type)
    "/": ("index.html", "text/html; charset=utf-8"),
    "/app.js": ("app.js", "text/javascript; charset=utf-8"),
    "/style.css": ("style.css", "text/css; charset=utf-8"),
    "/vis-network.min.js": ("vis-network.min.js", "text/javascript; charset=utf-8"),
}
CONFIG_NAME = "zk-graph.toml"  # looked up in <notebook>/.zk/
DIRECTIONS = ("both", "out", "in")
VIEW_NAME_RE = re.compile(r"\w[\w.-]*")
LABEL_MAX = 40
LABEL_SEPARATORS = (" — ", " – ")  # "Concept — definition" -> label "Concept"


class ZkError(Exception):
    """zk failed, or the notebook or its config can't be used."""


class ViewError(Exception):
    """A saved view can't be read or written: bad name, bad data, missing file."""


# ---- Configuration -----------------------------------------------------------

def find_notebook_dir(start):
    """Like zk: $ZK_NOTEBOOK_DIR, else the nearest parent directory with a .zk/."""
    env = os.environ.get("ZK_NOTEBOOK_DIR")
    if env:
        return Path(env).expanduser().resolve()
    start = Path(start).resolve()
    for d in (start, *start.parents):
        if (d / ".zk").is_dir():
            return d
    raise ZkError(f"No zk notebook found at or above {start} (and ZK_NOTEBOOK_DIR is unset)")


@dataclass
class Config:
    """Settings from <notebook>/.zk/zk-graph.toml, with defaults."""
    notebook: Path
    views_dir: Path
    # Order matters: the first tag listed that a note has decides its colour.
    tag_colors: dict = field(default_factory=dict)
    # Directory (relative to the notebook) -> colour for notes with no coloured
    # tag. Kept longest first, so the most specific directory wins.
    dir_colors: dict = field(default_factory=dict)
    default_color: str = "#97c2fc"
    open_cmd: list = field(default_factory=lambda: ["xdg-open", "{path}"])

    @classmethod
    def load(cls, notebook):
        cfg = cls(notebook=notebook, views_dir=notebook / ".zk" / "zk-graph" / "views")
        path = notebook / ".zk" / CONFIG_NAME
        if not path.is_file():
            return cfg
        try:
            raw = tomllib.loads(path.read_text())
        except (OSError, tomllib.TOMLDecodeError) as e:
            raise ZkError(f"Cannot read {path}: {e}")
        cfg.tag_colors = dict(raw.get("tag_colors", {}))
        dirs = {d.strip("/"): c for d, c in raw.get("dir_colors", {}).items() if d.strip("/")}
        cfg.dir_colors = dict(sorted(dirs.items(), key=lambda kv: -len(kv[0])))
        cfg.default_color = raw.get("default_color", cfg.default_color)
        open_cmd = raw.get("open_cmd", cfg.open_cmd)
        cfg.open_cmd = shlex.split(open_cmd) if isinstance(open_cmd, str) else list(open_cmd)
        if "views_dir" in raw:
            # Relative paths are relative to the notebook
            cfg.views_dir = notebook / Path(raw["views_dir"]).expanduser()
        return cfg

    def note_color(self, path, tags):
        """First configured tag colour, else the most specific dir colour, else the default."""
        for tag, color in self.tag_colors.items():
            if tag in tags:
                return color
        for d, color in self.dir_colors.items():
            if path.startswith(d + "/"):
                return color
        return self.default_color

    def legend(self):
        # Lists of pairs, not objects: JS would reorder integer-like keys such as "0"
        return {"tags": list(self.tag_colors.items()), "dirs": list(self.dir_colors.items()),
                "default": self.default_color}


# ---- The notebook graph ---------------------------------------------------------

def run_zk_graph(notebook):
    try:
        result = subprocess.run(
            ["zk", "--notebook-dir", str(notebook), "graph", "-f", "json", "-q"],
            capture_output=True, text=True, cwd=notebook,
        )
    except FileNotFoundError:
        raise ZkError("zk not found in PATH")
    if result.returncode != 0:
        raise ZkError(f"zk graph failed: {result.stderr.strip()}")
    try:
        return json.loads(result.stdout)
    except ValueError as e:
        raise ZkError(f"zk graph returned invalid JSON: {e}")


def changed_since(root, ts):
    """True if anything under root (hidden entries skipped) was modified after ts.
    File mtimes catch edits; directory mtimes catch new, deleted and renamed files."""
    if os.stat(root).st_mtime > ts:
        return True
    stack = [root]
    while stack:
        try:
            entries = list(os.scandir(stack.pop()))
        except OSError:
            continue
        for e in entries:
            if e.name.startswith("."):
                continue
            try:
                if e.stat(follow_symlinks=False).st_mtime > ts:
                    return True
                if e.is_dir(follow_symlinks=False):
                    stack.append(e.path)
            except OSError:
                continue
    return False


class Graph:
    """One snapshot of the notebook: notes by path, links, and adjacency."""

    def __init__(self, notes, links):
        self.notes = {n["path"]: n for n in notes}
        self.links = links
        # Unique neighbours per note, without self-links
        self.out, self.inc = {}, {}
        for link in links:
            src, tgt = link.get("sourcePath"), link.get("targetPath")
            if src == tgt or src not in self.notes or tgt not in self.notes:
                continue
            self.out.setdefault(src, set()).add(tgt)
            self.inc.setdefault(tgt, set()).add(src)

    def linked(self, path, direction="both"):
        """Notes that `path` links to (out), that link to it (in), or both."""
        if direction == "out":
            return self.out.get(path, set())
        if direction == "in":
            return self.inc.get(path, set())
        return self.out.get(path, set()) | self.inc.get(path, set())

    def select(self, text="", path_prefix="", depth=1, direction="both"):
        """Paths of notes matching text (in title, lead or path) and path prefix,
        plus notes up to `depth` links away in `direction`. No filter: all notes."""
        if not text and not path_prefix:
            return list(self.notes)
        text = text.lower()
        matched = {
            p for p, n in self.notes.items()
            if p.startswith(path_prefix)
            and text in f"{n.get('title') or ''} {n.get('lead') or ''} {p}".lower()
        }
        included, frontier = set(matched), set(matched)
        for _ in range(depth):
            frontier = {nb for p in frontier for nb in self.linked(p, direction)} - included
            if not frontier:
                break
            included |= frontier
        return [p for p in self.notes if p in included]

    def vis_edges(self, allowed):
        """Unique, non-self edges whose both endpoints are in `allowed`."""
        seen = set()
        edges = []
        for link in self.links:
            src, tgt = link.get("sourcePath"), link.get("targetPath")
            if src == tgt or (src, tgt) in seen or src not in allowed or tgt not in allowed:
                continue
            seen.add((src, tgt))
            edges.append({"id": f"{src}\n{tgt}", "from": src, "to": tgt})
        return edges


class Notebook:
    """The notebook's Graph, cached; re-read via zk only when files changed."""

    def __init__(self, root):
        self.root = root
        self.graph = None
        self._loaded_at = 0.0  # time.time() just before the last `zk graph` run
        self._lock = threading.Lock()

    def reload(self):
        # Stamp before running zk, so edits made while it runs trigger the next reload
        started = time.time()
        data = run_zk_graph(self.root)
        self.graph = Graph(data["notes"], data["links"])
        self._loaded_at = started
        return self.graph

    def current(self):
        with self._lock:
            if self.graph is None or changed_since(self.root, self._loaded_at):
                return self.reload()
            return self.graph


# ---- Graph -> vis-network data ---------------------------------------------------

def short_label(title):
    """The part of a title before its first separator, cut at a word boundary."""
    for sep in LABEL_SEPARATORS:
        head = title.split(sep, 1)[0]
        if head and head != title:
            title = head
            break
    if len(title) > LABEL_MAX:
        cut = title[:LABEL_MAX].rsplit(" ", 1)[0]
        title = (cut if len(cut) > LABEL_MAX // 2 else title[:LABEL_MAX]).rstrip(" ,.;-") + "…"
    return title


def vis_node(note, graph, config):
    path = note["path"]
    full = note.get("title") or note.get("lead") or note.get("filenameStem") or path
    tags = note.get("tags") or []
    preview = "\n".join((note.get("body") or "").strip().split("\n")[:8])
    # HTML for the popup shown on clicking the note. Not called "title": vis
    # would show that as a hover tooltip.
    details = f"<b>{html.escape(full)}</b>"
    if tags:
        details += f"<br><i>{html.escape(', '.join(tags))}</i>"
    details += (f"<br><small>{len(graph.linked(path, 'out'))} outgoing · "
                f"{len(graph.linked(path, 'in'))} backlinks</small>")
    if preview:
        details += f"<hr><pre>{html.escape(preview)}</pre>"
    return {
        "id": path,
        "label": short_label(full),
        "full": full,  # for search, which should also match the part cut from the label
        "color": config.note_color(path, tags),
        "details": details,
        # Size by log of distinct linked notes over the whole notebook, so a few
        # hubs don't shrink everything else to the minimum.
        "value": round(math.log2(len(graph.linked(path)) + 1), 3),
    }


def vis_graph(paths, graph, config, positions=None):
    """Nodes for those `paths` that still exist (at `positions`, if given) and
    the edges among them."""
    nodes = []
    for p in paths:
        if p not in graph.notes:
            continue
        node = vis_node(graph.notes[p], graph, config)
        pos = (positions or {}).get(p)
        if isinstance(pos, dict) and all(isinstance(pos.get(k), (int, float)) for k in ("x", "y")):
            node["x"], node["y"] = pos["x"], pos["y"]
        nodes.append(node)
    return {"nodes": nodes, "edges": graph.vis_edges({n["id"] for n in nodes})}


# ---- Saved views -----------------------------------------------------------------

class Views:
    """Saved views: one JSON file per view in a directory."""

    def __init__(self, directory):
        self.dir = directory

    def path(self, name):
        if not isinstance(name, str) or not VIEW_NAME_RE.fullmatch(name):
            raise ViewError(f"Bad view name {name!r}: use letters, digits, '_', '.' and '-'")
        return self.dir / f"{name}.json"

    def list(self):
        views = []
        for p in sorted(self.dir.glob("*.json")) if self.dir.is_dir() else []:
            if not VIEW_NAME_RE.fullmatch(p.stem):
                continue
            try:
                view = json.loads(p.read_text())
            except (OSError, ValueError):
                view = {}
            views.append({"name": p.stem, "saved": view.get("saved"),
                          "count": len(view.get("nodes") or {})})
        return views

    def read(self, name):
        path = self.path(name)
        try:
            view = json.loads(path.read_text())
        except FileNotFoundError:
            raise ViewError(f"No view {name!r} in {self.dir}")
        except (OSError, ValueError) as e:
            raise ViewError(f"Cannot read {path}: {e}")
        if not isinstance(view, dict) or not isinstance(view.get("nodes"), dict):
            raise ViewError(f"{path} has no 'nodes' object")
        return view

    def write(self, name, view):
        """Write atomically: temp file in the same dir, then rename over the old view."""
        path = self.path(name)
        path.parent.mkdir(parents=True, exist_ok=True)
        fd, tmp = tempfile.mkstemp(dir=path.parent, prefix=f".{name}.", suffix=".tmp")
        try:
            with os.fdopen(fd, "w") as f:
                json.dump(view, f, ensure_ascii=False, indent=1)
            os.replace(tmp, path)
        except BaseException:
            os.unlink(tmp)
            raise


def _finite(value, what):
    try:
        x = float(value)
    except (TypeError, ValueError):
        raise ViewError(f"Bad {what}: {value!r}")
    if not math.isfinite(x):
        raise ViewError(f"Bad {what}: {value!r}")
    return x


def clean_view(body):
    """Validate a /views/save payload into the on-disk view format."""
    nodes = body.get("nodes")
    if not isinstance(nodes, dict):
        raise ViewError("'nodes' must be an object")
    clean_nodes = {}
    for path, pos in nodes.items():
        if not isinstance(pos, dict):
            raise ViewError(f"Bad position for {path!r}")
        clean_nodes[path] = {"x": round(_finite(pos.get("x"), "x"), 1),
                             "y": round(_finite(pos.get("y"), "y"), 1)}
    vp = body.get("viewport")
    viewport = None
    if isinstance(vp, dict):
        viewport = {"scale": _finite(vp.get("scale"), "scale"),
                    "x": round(_finite(vp.get("x"), "x"), 1),
                    "y": round(_finite(vp.get("y"), "y"), 1)}
    origin = body.get("origin")
    return {
        "version": 1,
        "saved": datetime.now(timezone.utc).isoformat(timespec="seconds").replace("+00:00", "Z"),
        "nodes": clean_nodes,
        "viewport": viewport,
        "frozen": bool(body.get("frozen")),
        "origin": origin if isinstance(origin, dict) else None,
    }


def view_state(view, name):
    """What the page needs besides the graph to restore a view."""
    vp = view.get("viewport")
    return {"name": name, "viewport": vp if isinstance(vp, dict) else None,
            "frozen": bool(view.get("frozen")), "origin": view.get("origin")}


# ---- Opening notes ----------------------------------------------------------------

def open_note(path, config):
    """Run open_cmd with {path}/{notebook} filled in; path is appended if absent."""
    abs_path = str(config.notebook / path)
    # Plain str.replace per argument: no shell, so note paths can't inject commands
    cmd = [arg.replace("{path}", abs_path).replace("{notebook}", str(config.notebook))
           for arg in config.open_cmd]
    if not any("{path}" in arg for arg in config.open_cmd):
        cmd.append(abs_path)
    subprocess.Popen(
        cmd, cwd=config.notebook, start_new_session=True,
        stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
    )


# ---- The application: API handlers ----------------------------------------------

class HttpError(Exception):
    def __init__(self, status, message):
        super().__init__(message)
        self.status = status


class App:
    """State shared by all requests, and one method per API route. Each method
    takes the JSON request body and returns a JSON-serializable result."""

    def __init__(self, config, notebook, views, initial):
        self.config = config
        self.notebook = notebook
        self.views = views
        # What /init shows: {"paths", "positions", "view"}. Built from the
        # current notebook on each request, so reloading the page shows fresh notes.
        self.initial = initial
        self.token = secrets.token_urlsafe(32)
        self.allowed_hosts = set()  # set once the port is known

    def init(self):
        graph = self.notebook.current()
        return {
            "token": self.token,
            "legend": self.config.legend(),
            "view": self.initial["view"],
            "graph": vis_graph(self.initial["paths"], graph, self.config, self.initial["positions"]),
        }

    def open(self, body):
        path = body.get("path", "")
        if path not in self.notebook.graph.notes:
            raise HttpError(404, "unknown note")
        try:
            open_note(path, self.config)
        except OSError as e:
            raise HttpError(500, f"open_cmd failed: {e}")
        return {"ok": True}

    def neighbors(self, body):
        """The note's linked notes in `direction`, and edges among the shown and new notes."""
        path, direction = body.get("path", ""), body.get("direction", "both")
        if direction not in DIRECTIONS:
            raise HttpError(400, "bad direction")
        graph = self.notebook.current()
        found = graph.linked(path, direction)
        return {"nodes": [vis_node(graph.notes[p], graph, self.config) for p in found],
                "edges": graph.vis_edges(set(body.get("shown", [])) | found | {path})}

    def refresh(self, body):
        """Fresh nodes for the displayed paths that still exist, and the edges among them."""
        return vis_graph(body.get("paths", []), self.notebook.current(), self.config)

    def views_list(self, body):
        return {"views": self.views.list()}

    def views_load(self, body):
        name = body.get("name")
        view = self.views.read(name)
        graph = vis_graph(view["nodes"], self.notebook.current(), self.config, view["nodes"])
        return {"graph": graph, "missing": len(view["nodes"]) - len(graph["nodes"]),
                **view_state(view, name)}

    def views_save(self, body):
        name = body.get("name")
        self.views.write(name, clean_view(body))
        return {"ok": True, "name": name}


API_ROUTES = {
    "/open": App.open,
    "/neighbors": App.neighbors,
    "/refresh": App.refresh,
    "/views/list": App.views_list,
    "/views/load": App.views_load,
    "/views/save": App.views_save,
}


# ---- HTTP ------------------------------------------------------------------------

class Handler(BaseHTTPRequestHandler):
    """Static files and /init over GET; the API over POST. Security: only our
    own Host is accepted (blocks DNS rebinding), and POSTs need the per-run
    token in the X-Token header, which forces a CORS preflight that we never
    answer, so other sites in the browser can't call the API."""

    @property
    def app(self):
        return self.server.app

    def do_GET(self):
        if not self._host_ok():
            return self._send(403, b"forbidden")
        route = urllib.parse.urlparse(self.path).path
        if route == "/init":
            return self._respond(self.app.init)
        if route in STATIC_FILES:
            name, ctype = STATIC_FILES[route]
            # Read per request, so edits to static/ show up on a page reload
            return self._send(200, (STATIC_DIR / name).read_bytes(), ctype)
        if route == "/favicon.ico":
            return self._send(204)
        self._send(404, b"not found")

    def do_POST(self):
        token = self.headers.get("X-Token", "")
        if not self._host_ok() or not hmac.compare_digest(token.encode(), self.app.token.encode()):
            return self._send(403, b"forbidden")
        handler = API_ROUTES.get(urllib.parse.urlparse(self.path).path)
        if handler is None:
            return self._send(404, b"not found")
        length = int(self.headers.get("Content-Length") or 0)
        try:
            body = json.loads(self.rfile.read(length) or b"{}")
        except ValueError:
            return self._send(400, b"bad json")
        if not isinstance(body, dict):
            return self._send(400, b"body must be a JSON object")
        self._respond(lambda: handler(self.app, body))

    def _respond(self, produce):
        """Send produce()'s result as JSON, or map its exception to an HTTP error."""
        try:
            result = produce()
        except HttpError as e:
            return self._send(e.status, str(e).encode())
        except ViewError as e:
            return self._send(400, str(e).encode())
        except (ZkError, OSError) as e:
            return self._send(500, str(e).encode())
        self._send(200, json.dumps(result).encode(), "application/json; charset=utf-8")

    def _host_ok(self):
        return self.headers.get("Host", "") in self.app.allowed_hosts

    def _send(self, code, body=b"", ctype="text/plain; charset=utf-8"):
        self.send_response(code)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def log_message(self, format, *args):
        pass  # silence logs


# ---- CLI ---------------------------------------------------------------------------

def parse_args():
    parser = argparse.ArgumentParser(description="Visualize a zk notebook's link graph in the browser")
    parser.add_argument("--notebook", help="Notebook directory (default: $ZK_NOTEBOOK_DIR or nearest parent with .zk/)")
    parser.add_argument("--filter", default="", help="Filter notes by search string")
    parser.add_argument("--filter-path", default="", help="Filter notes by path prefix")
    parser.add_argument("--depth", type=int, default=1, help="How many link hops from matched notes to include (default: 1)")
    parser.add_argument("--direction", choices=DIRECTIONS, default="both",
                        help="Which links --depth follows: out = notes they link to, in = backlinks (default: both)")
    parser.add_argument("--view", help="Open a saved view (see --list-views) instead of filtering")
    parser.add_argument("--list-views", action="store_true", help="List saved views and exit")
    parser.add_argument("--port", type=int, default=8089, help="HTTP port (default: 8089)")
    parser.add_argument("--no-open", action="store_true", help="Don't open a browser")
    args = parser.parse_args()
    if args.view and (args.filter or args.filter_path):
        parser.error("--view can't be combined with --filter/--filter-path")
    return args


def print_views(views):
    listed = views.list()
    if not listed:
        print(f"No saved views in {views.dir}")
    for v in listed:
        print(f"{v['name']}\t{v['saved'] or '?'}\t{v['count']} notes")


def initial_selection(args, graph, views):
    """What to show at start, from --view or the filters: {"paths", "positions", "view"}."""
    if args.view:
        view = views.read(args.view)
        paths = [p for p in view["nodes"] if p in graph.notes]
        dropped = len(view["nodes"]) - len(paths)
        print(f"View {args.view}: {len(paths)} notes"
              + (f" ({dropped} deleted notes dropped)" if dropped else ""))
        return {"paths": paths, "positions": view["nodes"], "view": view_state(view, args.view)}
    paths = graph.select(args.filter, args.filter_path, args.depth, args.direction)
    print(f"After filter: {len(paths)} notes")
    if not paths:
        print("Warning: no notes matched the filter", file=sys.stderr)
    origin = {"filter": args.filter, "filter_path": args.filter_path,
              "depth": args.depth, "direction": args.direction}
    return {"paths": paths, "positions": None,
            "view": {"name": None, "viewport": None, "frozen": False, "origin": origin}}


def main():
    args = parse_args()
    if not (STATIC_DIR / "vis-network.min.js").is_file():
        sys.exit(f"Missing {STATIC_DIR}/: keep the static/ folder next to the script")
    try:
        root = Path(args.notebook).resolve() if args.notebook else find_notebook_dir(os.getcwd())
        config = Config.load(root)
        views = Views(config.views_dir)
        if args.list_views:
            return print_views(views)
        if args.view:
            views.read(args.view)  # fail fast, before the slow zk run
        print(f"Loading graph from zk notebook {root}...")
        notebook = Notebook(root)
        graph = notebook.reload()
        print(f"Total: {len(graph.notes)} notes, {len(graph.links)} links")
        initial = initial_selection(args, graph, views)
    except (ZkError, ViewError) as e:
        sys.exit(str(e))

    try:
        server = ThreadingHTTPServer(("127.0.0.1", args.port), Handler)
    except OSError as e:
        sys.exit(f"Cannot bind 127.0.0.1:{args.port}: {e.strerror}. Try another --port.")
    port = server.server_address[1]
    server.app = App(config, notebook, views, initial)
    server.app.allowed_hosts = {f"127.0.0.1:{port}", f"localhost:{port}"}

    url = f"http://127.0.0.1:{port}"
    print(f"Serving graph at {url}")
    if not args.no_open:
        webbrowser.open(url)
    try:
        server.serve_forever()
    except KeyboardInterrupt:
        print("\nStopped.")


if __name__ == "__main__":
    main()
