  var btn = this;
  btn.textContent = "Refreshing...";
  btn.disabled = true;
  var displayedPaths = nodes.getIds();
  api("/refresh", { paths: displayedPaths })
    .then(function(result) {
      // Update node content (tooltips, labels, colors)
      nodes.update(result.nodes.map(prepNode));
      // Remove nodes that no longer exist on disk
      var freshIds = new Set(result.nodes.map(function(n) { return n.id; }));
      displayedPaths.forEach(function(id) { if (!freshIds.has(id)) removeNode(id); });
      syncEdges(result.edges, function() { return true; });
      setInfo();
    })
    .catch(showError)
    .finally(function() {
      btn.textContent = "Refresh";
      btn.disabled = false;
