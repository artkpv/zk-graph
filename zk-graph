VIEW_NAME_RE = re.compile(r"\w[\w.-]*")


class ZkError(Exception):
    pass


class ViewError(Exception):
    pass


def find_notebook_dir(start):
    """Like zk: $ZK_NOTEBOOK_DIR, else the nearest parent directory with a .zk/."""
    env = os.environ.get("ZK_NOTEBOOK_DIR")
    if env:
        return Path(env).expanduser().resolve()
    start = Path(start).resolve()
    for d in (start, *start.parents):
        if (d / ".zk").is_dir():
            return d
    raise ZkError(f"No zk notebook found at or above {start} (and ZK_NOTEBOOK_DIR is unset)")


def load_config(notebook):
    """Apply <notebook>/.zk/zk-graph.toml, if present, to the module settings."""
    global TAG_COLORS, DIR_COLORS, DEFAULT_COLOR, OPEN_CMD, VIEWS_DIR
    VIEWS_DIR = notebook / ".zk" / "zk-graph" / "views"
    path = notebook / ".zk" / CONFIG_NAME
    if not path.is_file():
        return
    try:
        cfg = tomllib.loads(path.read_text())
    except (OSError, tomllib.TOMLDecodeError) as e:
        raise ZkError(f"Cannot read {path}: {e}")
    TAG_COLORS = dict(cfg.get("tag_colors", TAG_COLORS))
    dirs = {d.strip("/"): c for d, c in cfg.get("dir_colors", {}).items() if d.strip("/")}
    DIR_COLORS = dict(sorted(dirs.items(), key=lambda kv: -len(kv[0])))
    DEFAULT_COLOR = cfg.get("default_color", DEFAULT_COLOR)
    open_cmd = cfg.get("open_cmd", OPEN_CMD)
    OPEN_CMD = shlex.split(open_cmd) if isinstance(open_cmd, str) else list(open_cmd)
    if "views_dir" in cfg:
        # Relative paths are relative to the notebook
        VIEWS_DIR = notebook / Path(cfg["views_dir"]).expanduser()


def view_path(name):
    if not isinstance(name, str) or not VIEW_NAME_RE.fullmatch(name):
        raise ViewError(f"Bad view name {name!r}: use letters, digits, '_', '.' and '-'")
    return VIEWS_DIR / f"{name}.json"


def list_views():
    views = []
    for p in sorted(VIEWS_DIR.glob("*.json")) if VIEWS_DIR.is_dir() else []:
        if not VIEW_NAME_RE.fullmatch(p.stem):
            continue
        try:
            view = json.loads(p.read_text())
        except (OSError, ValueError):
            view = {}
        views.append({"name": p.stem, "saved": view.get("saved"), "count": len(view.get("nodes") or {})})
    return views


def read_view(name):
    path = view_path(name)
    try:
        view = json.loads(path.read_text())
    except FileNotFoundError:
        raise ViewError(f"No view {name!r} in {VIEWS_DIR}")
    except (OSError, ValueError) as e:
        raise ViewError(f"Cannot read {path}: {e}")
    if not isinstance(view, dict) or not isinstance(view.get("nodes"), dict):
        raise ViewError(f"{path} has no 'nodes' object")
    return view


def write_view(name, view):
    """Write atomically: temp file in the same dir, then rename over the old view."""
    path = view_path(name)
    path.parent.mkdir(parents=True, exist_ok=True)
    fd, tmp = tempfile.mkstemp(dir=path.parent, prefix=f".{name}.", suffix=".tmp")
    try:
        with os.fdopen(fd, "w") as f:
            json.dump(view, f, ensure_ascii=False, indent=1)
        os.replace(tmp, path)
    except BaseException:
        os.unlink(tmp)
        raise


def _finite(value, what):
    try:
        x = float(value)
    except (TypeError, ValueError):
        raise ViewError(f"Bad {what}: {value!r}")
    if not math.isfinite(x):
        raise ViewError(f"Bad {what}: {value!r}")
    return x


def clean_view(body):
    """Validate a /views/save payload into the on-disk view format."""
    nodes = body.get("nodes")
    if not isinstance(nodes, dict):
        raise ViewError("'nodes' must be an object")
    clean_nodes = {}
    for path, pos in nodes.items():
        if not isinstance(pos, dict):
            raise ViewError(f"Bad position for {path!r}")
        clean_nodes[path] = {"x": round(_finite(pos.get("x"), "x"), 1),
                             "y": round(_finite(pos.get("y"), "y"), 1)}
    vp = body.get("viewport")
    viewport = None
    if isinstance(vp, dict):
        viewport = {"scale": _finite(vp.get("scale"), "scale"),
                    "x": round(_finite(vp.get("x"), "x"), 1), "y": round(_finite(vp.get("y"), "y"), 1)}
    origin = body.get("origin")
    return {
        "version": 1,
        "saved": datetime.now(timezone.utc).isoformat(timespec="seconds").replace("+00:00", "Z"),
        "nodes": clean_nodes,
        "viewport": viewport,
        "frozen": bool(body.get("frozen")),
        "origin": origin if isinstance(origin, dict) else None,
    }


def get_graph_json():
    try:
        result = subprocess.run(
            ["zk", "--notebook-dir", NOTES_DIR, "graph", "-f", "json", "-q"],
            capture_output=True, text=True, cwd=NOTES_DIR,
        )
    except FileNotFoundError:
        raise ZkError("zk not found in PATH")
    if result.returncode != 0:
        raise ZkError(f"zk graph failed: {result.stderr.strip()}")
    try:
        return json.loads(result.stdout)
    except ValueError as e:
        raise ZkError(f"zk graph returned invalid JSON: {e}")


def changed_since(root, ts):
    """True if anything under root (hidden entries skipped) was modified after ts.
    File mtimes catch edits; directory mtimes catch new, deleted and renamed files."""
    if os.stat(root).st_mtime > ts:
        return True
    stack = [root]
    while stack:
        try:
            entries = list(os.scandir(stack.pop()))
        except OSError:
            continue
        for e in entries:
            if e.name.startswith("."):
                continue
            try:
                if e.stat(follow_symlinks=False).st_mtime > ts:
                    return True
                if e.is_dir(follow_symlinks=False):
                    stack.append(e.path)
            except OSError:
                continue
    return False


DIRECTIONS = ("both", "out", "in")


def adjacency(links, notes_by_path):
    """Unique neighbours per note as ({path: outgoing}, {path: incoming}), no self-links."""
    out, inc = {}, {}
    for link in links:
        src = link.get("sourcePath")
        tgt = link.get("targetPath")
        if src == tgt or src not in notes_by_path or tgt not in notes_by_path:
            continue
        out.setdefault(src, set()).add(tgt)
        inc.setdefault(tgt, set()).add(src)
    return out, inc


def linked(adj, path, direction="both"):
    """Notes that `path` links to (out), that link to it (in), or both."""
    out, inc = adj
    if direction == "out":
        return out.get(path, set())
    if direction == "in":
        return inc.get(path, set())
    return out.get(path, set()) | inc.get(path, set())


def filter_graph(data, adj, filter_str, filter_path, depth=1, direction="both"):
    if filter_str or filter_path:
        matched = set()
        for n in data["notes"]:
            path = n["path"]
            if filter_path and not path.startswith(filter_path):
                continue
            if filter_str:
                searchable = (n.get("title") or "") + " " + (n.get("lead") or "") + " " + path
                if filter_str.lower() not in searchable.lower():
                    continue
            matched.add(path)

        # BFS expansion to depth, following links in `direction`
        included = set(matched)
        frontier = set(matched)
        for _ in range(depth):
            next_frontier = set()
            for node in frontier:
                for nb in linked(adj, node, direction):
                    if nb not in included:
                        next_frontier.add(nb)
            included |= next_frontier
            frontier = next_frontier
            if not frontier:
                break

        data["notes"] = [n for n in data["notes"] if n["path"] in included]
        data["links"] = [
            l for l in data["links"]
            if l.get("sourcePath", "") in included and l.get("targetPath", "") in included
        ]

    return data


def note_color(path, tags):
    """First configured tag colour, else the most specific dir colour, else the default."""
    for tag, color in TAG_COLORS.items():
        if tag in tags:
            return color
    for d, color in DIR_COLORS.items():
        if path.startswith(d + "/"):
            return color
    return DEFAULT_COLOR


def note_to_vis_node(n, adj):
    label = n.get("title") or n.get("lead") or n.get("filenameStem") or n["path"]
    if len(label) > 60:
        label = label[:57] + "..."
    tags = n.get("tags") or []
    color = note_color(n["path"], tags)
    tags_str = ", ".join(tags)
    n_out = len(linked(adj, n["path"], "out"))
    n_in = len(linked(adj, n["path"], "in"))
    degree = len(linked(adj, n["path"]))
    body = (n.get("body") or "").strip()
    preview_lines = body.split("\n")[:8]
    preview = html_mod.escape("\n".join(preview_lines))
    tooltip = f"<b>{html_mod.escape(label)}</b>"
    if tags_str:
        tooltip += f"<br><i>{html_mod.escape(tags_str)}</i>"
    tooltip += f"<br><small>{n_out} outgoing · {n_in} backlinks</small>"
    if preview:
        tooltip += f"<hr style='margin:4px 0;border-color:#555'><pre style='margin:0;white-space:pre-wrap'>{preview}</pre>"
    # Size by log of distinct linked notes over the whole notebook, so a few
    # hubs don't shrink everything else to the minimum.
    value = round(math.log2(degree + 1), 3)
    return {"id": n["path"], "label": label, "color": color, "title": tooltip, "value": value}


def vis_edges(links, allowed):
    """Unique, non-self edges whose both endpoints are in `allowed`."""
    seen = set()
    edges = []
    for link in links:
        src = link.get("sourcePath")
        tgt = link.get("targetPath")
        if not src or not tgt or src == tgt or (src, tgt) in seen:
            continue
        if src not in allowed or tgt not in allowed:
            continue
        seen.add((src, tgt))
        edges.append({"id": f"{src}\n{tgt}", "from": src, "to": tgt})
    return edges


def build_vis_data(data, adj):
    nodes = [note_to_vis_node(n, adj) for n in data["notes"]]
    edges = vis_edges(data["links"], {n["path"] for n in data["notes"]})
    return {"nodes": nodes, "edges": edges}


def view_to_vis(view, notes_by_path, links, adj):
    """A saved view's notes with the notebook's current content and links, at
    their saved positions. Returns (vis data, number of deleted notes dropped)."""
    nodes = []
    for path, pos in view["nodes"].items():
        if path not in notes_by_path:
            continue
        node = note_to_vis_node(notes_by_path[path], adj)
        if isinstance(pos, dict) and all(isinstance(pos.get(k), (int, float)) for k in ("x", "y")):
            node["x"], node["y"] = pos["x"], pos["y"]
        nodes.append(node)
    edges = vis_edges(links, {n["id"] for n in nodes})
    return {"nodes": nodes, "edges": edges}, len(view["nodes"]) - len(nodes)


def view_state(view, name):
    """What the page needs besides the graph to restore a view."""
    vp = view.get("viewport")
    return {"name": name, "viewport": vp if isinstance(vp, dict) else None,
            "frozen": bool(view.get("frozen")), "origin": view.get("origin")}


